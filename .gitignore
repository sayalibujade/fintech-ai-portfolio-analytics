# ==========================================
# AI-Powered Portfolio Analytics Dashboard .gitignore
# ==========================================

# Enterprise Secrets and Security
.env
.env.local
.env.*.local
*.pem
*.key

# Dependency Directories (Recursive for multi-folder layout)
node_modules/
**/node_modules/
bower_components/

# Build and Compilation Footprints
dist/
**/dist/
tmp/
**/tmp/
out-tsc/
**/out-tsc/
bazel-out/
.angular/
**/.angular/cache/
.sass-cache/

# Testing Matrix and Coverage Logs
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
/libpeerconnection.log
__screenshots__/

# IDEs, Editors and System Noise
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.DS_Store
Thumbs.db

# Visual Studio Code Team Workspaces
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json